            "ref": "cohort_id",
            "type": "fk",
            "references": "cohorts"
          },
          {
            "ref": "title",
            "type": "text"
          },
          {
            "ref": "starts_at",
            "type": "timestamptz"
          },
          {
            "ref": "duration_min",
            "type": "int"
          },
          {
            "ref": "join_url",
            "type": "text"
          },
          {
            "ref": "recording_url",
            "type": "text"
          },
          {
            "ref": "status",
            "type": "enum",
            "enum": [
              "scheduled",
              "live",
              "ended"
            ]
          }
        ]
      }
    ]
  },
  "pages": [
    {
      "ref": "lms-dashboard",
      "template": "page-dashboard",
      "title": {
        "key": "mft.lms.page.dashboard",
        "fallback": "Dashboard"
      },
      "nav": {
        "group": "manifest:lms",
        "icon": "layout-dashboard",
        "order": 1
      }
    },
    {
      "ref": "lms-courses",
      "template": "page-crud",
      "title": {
        "key": "mft.lms.page.courses",
        "fallback": "Courses"
      },
      "nav": {
        "group": "manifest:lms",
        "icon": "book-open",
        "order": 2
      }
    },
    {
      "ref": "lms-cohorts",
      "template": "page-calendar",
      "title": {
        "key": "mft.lms.page.cohorts",
        "fallback": "Cohorts"
      },
      "nav": {
        "group": "manifest:lms",
        "icon": "calendar-days",
        "order": 3
      }
    },
    {
      "ref": "lms-grading",
      "template": "page-queue-inbox",
      "title": {
        "key": "mft.lms.page.grading",
        "fallback": "Grading"
      },
      "nav": {
        "group": "manifest:lms",
        "icon": "clipboard-check",
        "order": 4
      }
    },
    {
      "ref": "lms-questions",
      "template": "page-master-detail",
      "title": {
        "key": "mft.lms.page.questions",
        "fallback": "Questions"
      },
      "nav": {
        "group": "manifest:lms",
        "icon": "messages-square",
        "order": 5
      }
    },
    {
      "ref": "lms-exams",
      "template": "page-builder",
      "title": {
        "key": "mft.lms.page.exams",
        "fallback": "Exams"
      },
      "nav": {
        "group": "manifest:lms",
        "icon": "file-check",
        "order": 6
      }
    },
    {
      "ref": "lms-students",
      "template": "page-directory",
      "title": {
        "key": "mft.lms.page.students",
        "fallback": "Students"
      },
      "nav": {
        "group": "manifest:lms",
        "icon": "users",
        "order": 7
      }
    },
    {
      "ref": "lms-media",
      "template": "page-files",
      "title": {
        "key": "mft.lms.page.media",
        "fallback": "Media"
      },
      "nav": {
        "group": "manifest:lms",
        "icon": "folder",
        "order": 8
      }
    },
    {
      "ref": "lms-orders",
      "template": "page-crud",
      "title": {
        "key": "mft.lms.page.orders",
        "fallback": "Orders"
      },
      "nav": {
        "group": "manifest:lms",
        "icon": "receipt",
        "order": 9
      }
    }
  ],
  "capabilities": [
    "payments",
    "file-storage",
    "email-delivery",
    "realtime"
  ],
  "kind": "app",
  "frontends": [
    {
      "side": "staff",
      "kind": "spa",
      "entry": "index.html",
      "env": {
        "VITE_ADMINIUM_API_BASE_URL": {
          "required": false,
          "example": "https://admin.example.com"
        },
        "VITE_ADMINIUM_PUBLISHABLE_KEY": {
          "required": false,
          "example": "adm_pub_..."
        }
      },
      "routes": {
        "teach": "/"
      }
    },
    {
      "side": "customer",
      "kind": "spa",
      "entry": "index.html",
      "env": {
        "VITE_ADMINIUM_API_BASE_URL": {
          "required": false,
          "example": "https://admin.example.com"
        },
        "VITE_ADMINIUM_PUBLISHABLE_KEY": {
          "required": false,
          "example": "adm_pub_..."
        }
      },
      "routes": {
        "catalog": "/",
        "classroom": "/"
      }
    }
  ]
}
