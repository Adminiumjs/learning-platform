          },
          {
            "ref": "closes_at",
            "type": "timestamptz"
          },
          {
            "ref": "duration_min",
            "type": "int"
          },
          {
            "ref": "attempts_allowed",
            "type": "int"
          },
          {
            "ref": "pass_score",
            "type": "int"
          }
        ]
      },
      {
        "ref": "exam_questions",
        "columns": [
