          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "exam_id",
            "type": "fk",
            "references": "exams"
          },
          {
            "ref": "enrollment_id",
            "type": "fk",
            "references": "enrollments"
          },
          {
            "ref": "started_at",
            "type": "timestamptz"
          },
          {
            "ref": "submitted_at",
            "type": "timestamptz"
          },
          {
            "ref": "answers",
            "type": "json"
          },
          {
            "ref": "score",
            "type": "decimal"
          },
          {
            "ref": "status",
            "type": "enum",
            "enum": [
              "in_progress",
              "submitted",
              "graded"
            ]
          }
        ]
      },
      {
        "ref": "announcements",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "cohort_id",
            "type": "fk",
            "references": "cohorts"
          },
          {
            "ref": "instructor_id",
            "type": "fk",
            "references": "instructors"
          },
          {
            "ref": "title",
            "type": "text"
          },
          {
            "ref": "body",
            "type": "text"
          },
          {
            "ref": "pinned",
            "type": "bool"
