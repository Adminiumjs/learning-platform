{
  "manifestVersion": 1,
  "key": "lms",
  "name": "Learning Platform",
  "version": "1.0.0",
  "publisher": {
    "id": "adminium",
    "name": "Adminium",
    "url": "https://adminium.dev"
  },
  "license": "AGPL-3.0-only",
  "description": {
    "key": "mft.lms.desc",
    "fallback": "A course platform with enrollments, lessons that unlock week by week, exams and student questions — backed by your own database."
  },
  "categories": [
    "commerce"
  ],
  "compatibility": {
    "minAdminiumVersion": "1.0.0",
    "engines": [
      "postgres",
      "mysql",
      "sqlite"
    ],
    "requires": [
      "realtime"
    ]
  },
  "requiredSchema": {
    "tables": [
      {
        "ref": "instructors",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "name",
            "type": "text"
          },
          {
            "ref": "email",
            "type": "text",
            "semantic": "email"
          },
          {
            "ref": "initials",
            "type": "text"
          },
          {
            "ref": "avatar",
            "type": "text",
            "semantic": "image"
          },
          {
            "ref": "tint",
            "type": "text"
          },
          {
            "ref": "bio",
            "type": "text"
          },
          {
            "ref": "created_at",
            "type": "timestamptz"
          }
        ]
      },
      {
        "ref": "students",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "name",
            "type": "text"
          },
          {
            "ref": "email",
            "type": "text",
            "semantic": "email"
          },
          {
            "ref": "initials",
            "type": "text"
          },
          {
            "ref": "avatar",
            "type": "text",
            "semantic": "image"
          },
          {
            "ref": "created_at",
            "type": "timestamptz"
          }
        ]
      },
      {
        "ref": "courses",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "code",
            "type": "text"
          },
          {
            "ref": "title",
            "type": "text"
          },
          {
            "ref": "slug",
            "type": "text"
          },
          {
            "ref": "summary",
            "type": "text"
          },
          {
            "ref": "description",
            "type": "text"
          },
          {
            "ref": "cover",
            "type": "text",
            "semantic": "image"
          },
          {
            "ref": "tint",
            "type": "text"
          },
          {
            "ref": "icon",
            "type": "text"
          },
          {
            "ref": "price",
            "type": "money"
          },
          {
            "ref": "level",
            "type": "enum",
            "enum": [
              "beginner",
              "intermediate",
              "advanced"
            ]
          },
          {
            "ref": "mode",
            "type": "enum",
            "enum": [
              "self_paced",
              "cohort"
            ]
          },
          {
            "ref": "status",
            "type": "enum",
            "enum": [
              "draft",
              "published",
              "archived"
            ]
          },
          {
            "ref": "category",
            "type": "text"
          },
          {
            "ref": "instructor_id",
            "type": "fk",
            "references": "instructors"
          },
          {
            "ref": "created_at",
            "type": "timestamptz"
          }
        ]
      },
      {
        "ref": "modules",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "course_id",
            "type": "fk",
            "references": "courses"
          },
          {
            "ref": "title",
            "type": "text"
          },
          {
            "ref": "position",
            "type": "int"
          },
          {
            "ref": "week",
            "type": "int"
          }
        ]
      },
      {
        "ref": "lessons",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "module_id",
            "type": "fk",
            "references": "modules"
          },
          {
            "ref": "title",
            "type": "text"
          },
          {
            "ref": "kind",
            "type": "enum",
            "enum": [
              "video",
              "reading",
              "assignment",
              "exam",
              "live"
            ]
          },
          {
            "ref": "duration_min",
            "type": "int"
          },
          {
            "ref": "content",
            "type": "text"
          },
          {
            "ref": "media_url",
            "type": "text"
          },
          {
            "ref": "position",
            "type": "int"
          },
          {
            "ref": "publish_at",
            "type": "timestamptz"
          },
          {
            "ref": "preview",
            "type": "bool"
          }
        ]
      },
      {
        "ref": "cohorts",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "course_id",
            "type": "fk",
            "references": "courses"
          },
          {
            "ref": "name",
            "type": "text"
          },
          {
            "ref": "starts_on",
            "type": "date"
          },
          {
            "ref": "ends_on",
            "type": "date"
          },
          {
            "ref": "capacity",
            "type": "int"
          },
          {
            "ref": "status",
            "type": "enum",
            "enum": [
              "upcoming",
              "active",
              "completed"
            ]
          }
        ]
      },
      {
        "ref": "enrollments",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "student_id",
            "type": "fk",
            "references": "students"
          },
          {
            "ref": "course_id",
            "type": "fk",
            "references": "courses"
          },
          {
            "ref": "cohort_id",
            "type": "fk",
            "references": "cohorts"
          },
          {
            "ref": "status",
            "type": "enum",
            "enum": [
              "active",
              "completed",
              "refunded",
              "cancelled"
            ]
          },
          {
            "ref": "progress_pct",
            "type": "int"
          },
          {
            "ref": "enrolled_at",
            "type": "timestamptz"
          }
        ]
      },
      {
        "ref": "orders",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "number",
            "type": "text"
          },
          {
            "ref": "student_id",
            "type": "fk",
            "references": "students"
          },
          {
            "ref": "course_id",
            "type": "fk",
            "references": "courses"
          },
          {
            "ref": "amount",
            "type": "money"
          },
          {
            "ref": "status",
            "type": "enum",
            "enum": [
              "pending",
              "paid",
              "refunded"
            ]
          },
          {
            "ref": "placed_at",
            "type": "timestamptz"
          }
        ]
      },
      {
        "ref": "lesson_progress",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "enrollment_id",
            "type": "fk",
            "references": "enrollments"
          },
          {
            "ref": "lesson_id",
            "type": "fk",
            "references": "lessons"
          },
          {
            "ref": "completed",
            "type": "bool"
          },
          {
            "ref": "seconds",
            "type": "int"
          },
          {
            "ref": "completed_at",
            "type": "timestamptz"
          }
        ]
      },
      {
        "ref": "assignments",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "lesson_id",
            "type": "fk",
            "references": "lessons"
          },
          {
            "ref": "title",
            "type": "text"
          },
          {
            "ref": "instructions",
            "type": "text"
          },
          {
            "ref": "due_at",
            "type": "timestamptz"
          },
          {
            "ref": "points",
            "type": "int"
          }
        ]
      },
      {
        "ref": "submissions",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "assignment_id",
            "type": "fk",
            "references": "assignments"
          },
          {
            "ref": "enrollment_id",
            "type": "fk",
            "references": "enrollments"
          },
          {
            "ref": "body",
            "type": "text"
          },
          {
            "ref": "attachment",
            "type": "blob"
          },
          {
            "ref": "submitted_at",
            "type": "timestamptz"
          },
          {
            "ref": "score",
            "type": "decimal"
          },
          {
            "ref": "feedback",
            "type": "text"
          },
          {
            "ref": "graded_at",
            "type": "timestamptz"
          },
          {
            "ref": "graded_by",
            "type": "fk",
            "references": "instructors"
          }
        ]
      },
      {
        "ref": "exams",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "course_id",
            "type": "fk",
            "references": "courses"
          },
          {
            "ref": "cohort_id",
            "type": "fk",
            "references": "cohorts"
          },
          {
            "ref": "title",
            "type": "text"
          },
          {
            "ref": "opens_at",
