          },
          {
            "ref": "options",
            "type": "json"
          },
          {
            "ref": "answer",
            "type": "json"
          },
          {
            "ref": "points",
            "type": "int"
          },
          {
            "ref": "position",
            "type": "int"
          }
        ]
      },
      {
        "ref": "exam_attempts",
